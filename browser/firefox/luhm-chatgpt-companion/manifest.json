{
  "manifest_version": 3,
  "name": "LuHm ChatGPT Companion",
  "version": "0.3.1",
  "description": "Private-first Firefox Android companion for the sealed ChatGPT-only Lum roleplay lane, with localhost asset, reward-banner, and terminal bridges.",
  "browser_specific_settings": {
    "gecko": {
      "id": "luhm-chatgpt-companion@eggiebagelface.art",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["none"]}
    },
    "gecko_android": {}
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8799/*",
    "http://localhost:8799/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "LuHm Companion",
    "default_popup": "popup.html",
    "default_icon": "icons/luhm.svg"
  },
  "icons": {"48": "icons/luhm.svg", "96": "icons/luhm.svg"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
