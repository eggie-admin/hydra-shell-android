#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

BRANCH="feature/lum-chatgpt-companion-extension"
REPO="$HOME/luhm-firefox"
ROOT="$REPO/browser/firefox/luhm-chatgpt-companion"
VERSION="0.4.0"
NIGHTLY_PKG="org.mozilla.fenix"
DEST="$HOME/storage/downloads/LuHm-ChatGPT-Companion-$VERSION-SIGNED.xpi"

banner() { printf '\n=== %s ===\n' "$1"; }

banner "LUHM CATHEDRAL / OWNER PROFILE GATE"
CURRENT_USER="$(am get-current-user 2>/dev/null | tr -dc '0-9' || true)"
if [ -n "$CURRENT_USER" ]; then
  echo "Android user: $CURRENT_USER"
  if [ "$CURRENT_USER" != "0" ]; then
    echo "ABORT: this installer is intended for ordinary Termux in Android owner profile user 0, outside Samsung Secure Folder." >&2
    exit 30
  fi
else
  echo "Android user: unknown (continuing; confirm this is ordinary Termux outside Secure Folder)."
fi

banner "FIREFOX NIGHTLY GATE"
if ! pm path "$NIGHTLY_PKG" >/dev/null 2>&1; then
  echo "Firefox Nightly is not installed in this Android profile."
  echo "Opening the Play Store Nightly page. Install it, return to Termux, and rerun this command."
  am start -a android.intent.action.VIEW -d "market://details?id=$NIGHTLY_PKG" >/dev/null 2>&1 || \
    am start -a android.intent.action.VIEW -d "https://play.google.com/store/apps/details?id=$NIGHTLY_PKG" >/dev/null 2>&1 || true
  exit 31
fi
pm path "$NIGHTLY_PKG" | sed -n '1p'

banner "SOURCE OF TRUTH"
command -v git >/dev/null 2>&1 || pkg install -y git
if [ ! -d "$REPO/.git" ]; then
  git clone --depth=1 --branch "$BRANCH" https://github.com/eggie-admin/hydra-shell-android.git "$REPO"
else
  cd "$REPO"
  git fetch --depth=1 origin "$BRANCH"
  git reset --hard "origin/$BRANCH"
fi
cd "$ROOT"

banner "TERMUX DEPENDENCIES"
command -v python >/dev/null 2>&1 || pkg install -y python
command -v node >/dev/null 2>&1 || pkg install -y nodejs
command -v npm >/dev/null 2>&1 || pkg install -y nodejs
command -v unzip >/dev/null 2>&1 || pkg install -y unzip
command -v sha256sum >/dev/null 2>&1 || pkg install -y coreutils

if [ ! -d "$HOME/storage" ]; then
  echo "Termux shared storage is not enabled."
  echo "Run: termux-setup-storage"
  echo "Approve Android's storage prompt, then rerun this installer."
  exit 32
fi

chmod +x \
  termux/install-live2d-runtime \
  termux/full-live2d-mutation \
  termux/final-firefox-install \
  termux/luhm-private-bridge 2>/dev/null || true

banner "PRIVATE MOZILLA SIGNING CREDENTIALS"
if [ -z "${WEB_EXT_API_KEY:-}" ]; then
  read -r -p "AMO JWT issuer: " WEB_EXT_API_KEY
  export WEB_EXT_API_KEY
fi
if [ -z "${WEB_EXT_API_SECRET:-}" ]; then
  read -r -s -p "AMO JWT secret: " WEB_EXT_API_SECRET
  echo
  export WEB_EXT_API_SECRET
fi
if [ -z "${WEB_EXT_API_KEY:-}" ] || [ -z "${WEB_EXT_API_SECRET:-}" ]; then
  echo "Signing credentials are required for the final Nightly install build." >&2
  exit 33
fi

banner "FULL PRIVATE LIVE2D + FIREFOX FORGE + SIGN"
termux/final-firefox-install

[ -f "$DEST" ] || {
  echo "Signed XPI was not produced: $DEST" >&2
  exit 34
}

banner "SIGNED XPI VERIFY"
sha256sum "$DEST"
if unzip -l "$DEST" | grep -q 'META-INF/'; then
  echo "signature metadata: PRESENT"
else
  echo "WARNING: no META-INF signature metadata found in signed XPI listing" >&2
fi

banner "PRIVATE ASSET BRIDGE"
termux/luhm-private-bridge restart
termux/luhm-private-bridge status

banner "FIREFOX NIGHTLY HANDOFF"
monkey -p "$NIGHTLY_PKG" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true
sleep 1

if command -v termux-open >/dev/null 2>&1; then
  termux-open --view --chooser --content-type application/x-xpinstall "$DEST" >/dev/null 2>&1 || \
  termux-open --chooser "$DEST" >/dev/null 2>&1 || true
else
  am start -a android.intent.action.VIEW -t application/x-xpinstall -d "file://$DEST" -p "$NIGHTLY_PKG" >/dev/null 2>&1 || true
fi

banner "CATHEDRAL GREEN"
echo "ANDROID_USER=${CURRENT_USER:-unknown}"
echo "FIREFOX_NIGHTLY=$NIGHTLY_PKG"
echo "SIGNED_XPI=$DEST"
echo "BRIDGE=http://127.0.0.1:8799/"
echo "SEAL=LUM_FIREFOX_LIVE2D_FULL_MUTATION_20260911"
echo "CATHEDRAL_NIGHTLY_INSTALL_READY"
echo
echo "If Android shows an app chooser, choose Firefox Nightly."
echo "If Nightly does not immediately offer Add:"
echo "  Settings > About Firefox > tap Firefox logo 5x (once to unlock developer options)"
echo "  Back > Settings > Install Extension from File"
echo "  Select LuHm-ChatGPT-Companion-$VERSION-SIGNED.xpi and tap Add."
