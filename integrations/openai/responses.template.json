{
  "schema": "kai9000.openai-responses-template.v2",
  "endpoint": "https://api.openai.com/v1/responses",
  "model_env": "OPENAI_MODEL",
  "default_model": "gpt-5.6-sol",
  "credential_env": "OPENAI_API_KEY",
  "allowed_models_env": "KAI_OPENAI_ALLOWED_MODELS",
  "request": {
    "model": "${OPENAI_MODEL}",
    "instructions": "KAI policy-owned instructions are injected server-side.",
    "input": "${USER_INPUT}",
    "store": false,
    "max_output_tokens": 1600
  },
  "policy": {
    "typed_tools_only": true,
    "credentials_visible_to_model": false,
    "requested_models_must_be_allowlisted": true,
    "provider_output_is_untrusted_until_validated": true,
    "secret_ingress_guard": true,
    "secret_egress_guard": true,
    "silent_cross_provider_failover": false
  }
}
