{
  "schema": "kai9000.cloudflare-dns-security-template.v1",
  "zone": "eggiebagelface.art",
  "mode": "tunnel_preferred",
  "records": [
    {
      "type": "CNAME",
      "name": "eggiebagelface.art",
      "content": "<CF_TUNNEL_ID>.cfargotunnel.com",
      "proxied": true,
      "ttl": 1,
      "purpose": "public business site through Cloudflare Tunnel"
    },
    {
      "type": "CNAME",
      "name": "www.eggiebagelface.art",
      "content": "eggiebagelface.art",
      "proxied": true,
      "ttl": 1
    },
    {
      "type": "CNAME",
      "name": "fdroid.eggiebagelface.art",
      "content": "<CF_TUNNEL_ID>.cfargotunnel.com",
      "proxied": true,
      "ttl": 1,
      "purpose": "public F-Droid repository"
    },
    {
      "type": "CNAME",
      "name": "admin.eggiebagelface.art",
      "content": "<CF_TUNNEL_ID>.cfargotunnel.com",
      "proxied": true,
      "ttl": 1,
      "purpose": "Access-protected admin surface"
    },
    {
      "type": "CAA",
      "name": "eggiebagelface.art",
      "tag": "issue",
      "value": "letsencrypt.org",
      "purpose": "authorize selected origin CA; Cloudflare Universal may synthesize additional partner-CA CAA records"
    },
    {
      "type": "CAA",
      "name": "eggiebagelface.art",
      "tag": "issuewild",
      "value": "letsencrypt.org",
      "purpose": "authorize wildcard origin certificate"
    }
  ],
  "dnssec": {
    "desired_status": "active",
    "registrar_action_required": "publish Cloudflare-generated DS record",
    "manual_dnskey": false,
    "expected_algorithm": "13 ECDSA P-256 SHA-256"
  },
  "direct_ipv6_fallback": {
    "enabled_by_default": false,
    "rule": "If Tunnel is unavailable by design, publish proxied AAAA to the real origin IPv6 and do not publish a public A record.",
    "origin_ipv6": "<GCP_VM_EXTERNAL_IPV6>"
  },
  "forbidden": [
    "public .lan records",
    "unproxied origin A/AAAA without explicit review",
    "TLSA pinning of Cloudflare-proxied HTTPS",
    "Global API Key in automation"
  ]
}
