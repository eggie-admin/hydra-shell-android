# Example origin NGINX config for a private/self-hosted CMS behind Cloudflare.
# FastAPI Cloud deployments normally do not need this origin config.

server {
    listen 443 ssl http2;
    server_name cms.eggiebagelface.art;

    ssl_certificate /etc/letsencrypt/live/cms.eggiebagelface.art/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cms.eggiebagelface.art/privkey.pem;

    # Optional: Cloudflare Authenticated Origin Pull validation.
    # Start optional for testing, switch to 'on' only after verifying Cloudflare can reach the origin.
    ssl_verify_client optional;
    ssl_client_certificate /etc/nginx/certs/cloudflare.crt;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
