  "remote_control_plane": {
    "provider": "google_cloud",
    "machine_type": "e2-micro",
    "role": "control_and_smoke_only",
    "android_compile_workloads": false,
    "artifact_compile_workloads": false,
    "external_ipv4": false,
    "authentication": "workload_identity_federation",
    "long_lived_service_account_json": false,
    "reason": "Preserve the strict-free remote lane for orchestration and health checks; compilation stays on the higher-throughput hosted build iron."
