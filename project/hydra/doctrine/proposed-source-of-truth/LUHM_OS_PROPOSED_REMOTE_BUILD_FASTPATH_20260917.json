    "reason": "The x64 hosted image is the Android forge lane. Target ABI is independent of host ISA, and the forge requires the Android SDK/tooling contract."
  },
  "android_contract": {
    "target_abi": "arm64-v8a",
    "min_sdk": 24,
    "target_sdk": 36,
    "build_tools": "36.1.0",
    "sdk_strategy": "verify_preinstalled_then_fallback_install",
    "sdk_hot_path_network_install": false,
    "package_id_candidate": "art.eggiebagelface.luhmos.candidate"
  },
  "toolchain": {
    "java": "17",
    "node": "24",
    "godot": "4.7.2-stable",
    "github_gradle": "8.13",
