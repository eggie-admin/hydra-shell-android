  },
  "cache_contract": {
    "gradle_user_home": "gradle_actions_setup_gradle_managed",
    "godot_editor_archive": "actions_cache_sha_keyed",
    "godot_export_templates": "actions_cache_sha_keyed",
    "godot_prepared_android_template": "actions_cache_sha_keyed",
    "android_gradle_distribution": "actions_cache_sha_keyed",
    "hash_validation_after_restore": true,
    "cache_miss_downloads_only": true,
    "cache_key_contains_tool_hashes": true
