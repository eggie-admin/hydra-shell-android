[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://luhm/agent-mesh-debug/agent_mesh_debug.gd" id="1_mesh"]

[node name="AgentMeshDebug" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_mesh")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.018, 0.01, 0.03, 1)
mouse_filter = 2

[node name="Safe" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 28.0
offset_top = 40.0
offset_right = -28.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Safe"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Safe/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.56, 0.85, 1)
theme_override_font_sizes/font_size = 30
text = "LUHM AGENT MESH v1"
horizontal_alignment = 1

[node name="Law" type="Label" parent="Safe/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.58, 0.95, 0.86, 1)
theme_override_font_sizes/font_size = 17
text = "ONE BOSS: LUM  ·  HELPERS -> BOSS  ·  DEPTH 1  ·  MAX 3\nOFFLINE DEBUG HARNESS  ·  NO NETWORK  ·  NO SHELL  ·  NO SILENT INSTALL"
horizontal_alignment = 1

[node name="Session" type="Label" parent="Safe/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "SESSION"
horizontal_alignment = 1

[node name="Buttons" type="GridContainer" parent="Safe/VBox"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12

[node name="Direct" type="Button" parent="Safe/VBox/Buttons"]
layout_mode = 2
text = "DIRECT FASTPATH"

[node name="Context" type="Button" parent="Safe/VBox/Buttons"]
layout_mode = 2
text = "CONTEXT BLADE"

[node name="Build" type="Button" parent="Safe/VBox/Buttons"]
layout_mode = 2
text = "BUILD BLADE"

[node name="Research" type="Button" parent="Safe/VBox/Buttons"]
layout_mode = 2
text = "RESEARCH BLADE"

[node name="Multi" type="Button" parent="Safe/VBox/Buttons"]
layout_mode = 2
text = "3-BLADE + CRITIC"

[node name="CrownRequired" type="Button" parent="Safe/VBox/Buttons"]
layout_mode = 2
text = "CROWN REQUIRED"

[node name="AuthorizedEdge" type="Button" parent="Safe/VBox/Buttons"]
layout_mode = 2
text = "AUTHORIZED TOOL EDGE"

[node name="Savepoint" type="Button" parent="Safe/VBox/Buttons"]
layout_mode = 2
text = "LOCAL SAVEPOINT"

[node name="Output" type="Label" parent="Safe/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.93, 0.9, 1, 1)
theme_override_font_sizes/font_size = 19
text = "BOSS: LUM"
autowrap_mode = 2
vertical_alignment = 1

[node name="Footer" type="Label" parent="Safe/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.6, 0.75, 1)
theme_override_font_sizes/font_size = 14
text = "WHISPER · CROSSING · RECKONING   |   POWER LEVEL != PERMISSION LEVEL"
horizontal_alignment = 1

[connection signal="pressed" from="Safe/VBox/Buttons/Direct" to="." method="_on_direct_pressed"]
[connection signal="pressed" from="Safe/VBox/Buttons/Context" to="." method="_on_context_pressed"]
[connection signal="pressed" from="Safe/VBox/Buttons/Build" to="." method="_on_build_pressed"]
[connection signal="pressed" from="Safe/VBox/Buttons/Research" to="." method="_on_research_pressed"]
[connection signal="pressed" from="Safe/VBox/Buttons/Multi" to="." method="_on_multi_pressed"]
[connection signal="pressed" from="Safe/VBox/Buttons/CrownRequired" to="." method="_on_crown_required_pressed"]
[connection signal="pressed" from="Safe/VBox/Buttons/AuthorizedEdge" to="." method="_on_authorized_edge_pressed"]
[connection signal="pressed" from="Safe/VBox/Buttons/Savepoint" to="." method="_on_savepoint_pressed"]
