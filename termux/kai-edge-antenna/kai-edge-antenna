#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/kai-edge-antenna"
VENV="${KAI_EDGE_VENV:-$HOME/.local/share/kai-edge-antenna/venv}"
HOST="127.0.0.1"
PORT="${KAI_MINI_OLLAMA_PORT:-11434}"
PIDFILE="$STATE/mini-ollama.pid"
LOGFILE="$STATE/mini-ollama.log"
mkdir -p "$STATE" "$(dirname "$VENV")"

bootstrap() {
  command -v python >/dev/null 2>&1 || {
    echo "python missing; run: pkg install python" >&2
    exit 2
  }
  if [ ! -x "$VENV/bin/python" ]; then
    python -m venv "$VENV"
  fi
  "$VENV/bin/python" -m pip install --upgrade pip
  "$VENV/bin/python" -m pip install fastapi uvicorn httpx
}

alive() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
  if alive; then
    echo "mini-ollama antenna already running pid=$(cat "$PIDFILE")"
    return
  fi
  [ -x "$VENV/bin/python" ] || bootstrap
  nohup "$VENV/bin/python" -m uvicorn mini_ollama_antenna:APP \
    --app-dir "$HERE" --host "$HOST" --port "$PORT" \
    >"$LOGFILE" 2>&1 &
  echo $! > "$PIDFILE"
  sleep 1
  if ! alive; then
    echo "mini-ollama antenna failed to start" >&2
    tail -n 80 "$LOGFILE" >&2 || true
    exit 1
  fi
  echo "mini-ollama antenna: http://$HOST:$PORT"
}

stop() {
  if alive; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      alive || break
      sleep 1
    done
  fi
  rm -f "$PIDFILE"
}

status() {
  echo "=== KAI 9000 EDGE ANTENNA ==="
  if alive; then
    echo "process: GREEN pid=$(cat "$PIDFILE")"
  else
    echo "process: OFF"
  fi
  echo
  echo "[mini Ollama shim]"
  curl -fsS "http://$HOST:$PORT/health" 2>/dev/null | python -m json.tool || echo "OFF"
  echo
  echo "[canonical KAI antenna]"
  curl -fsS "http://127.0.0.1:8797/api/antenna/status" 2>/dev/null | python -m json.tool || echo "OFF or not started"
  echo
  echo "[Edge Gallery package visibility probe]"
  if command -v cmd >/dev/null 2>&1; then
    cmd package list packages com.google.aiedge.gallery 2>/dev/null || true
  elif command -v pm >/dev/null 2>&1; then
    pm list packages com.google.aiedge.gallery 2>/dev/null || true
  else
    echo "package probe unavailable from this Termux build"
  fi
}

secure_probe() {
  echo "Run these from the Samsung Secure Folder AcodeX terminal/client:"
  cat <<'EOF'
curl -fsS http://127.0.0.1:11434/health | python -m json.tool
curl -fsS http://127.0.0.1:8797/api/antenna/status | python -m json.tool
curl -fsS http://127.0.0.1:8767/ >/dev/null && echo 'AcodeX owner-plane bridge reachable'
EOF
}

case "${1:-status}" in
  bootstrap) bootstrap ;;
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  secure-probe) secure_probe ;;
  logs) tail -n 120 "$LOGFILE" 2>/dev/null || true ;;
  *) echo "usage: $0 {bootstrap|start|stop|restart|status|secure-probe|logs}"; exit 2 ;;
esac
